rules_version = '2';
// All data access goes through the Cloud Run API (Admin SDK), which bypasses
// these rules. Direct client access is denied so nothing can read or write the
// database without going through the validated, auth-checked API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
